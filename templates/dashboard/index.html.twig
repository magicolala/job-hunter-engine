<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Job Hunter Dashboard</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

        :root {
            --bg: #f6f0e8;
            --ink: #1d1a16;
            --muted: #6b635c;
            --accent: #ff6b4a;
            --accent-2: #2e7d6b;
            --card: #fff7ee;
            --border: #e3d7cb;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Space Grotesk', sans-serif;
            color: var(--ink);
            background: radial-gradient(80% 60% at 10% 10%, #fff1e2 0%, var(--bg) 45%, #f2ebe2 100%);
        }

        .page {
            max-width: 1200px;
            margin: 0 auto;
            padding: 32px 24px 80px;
        }

        .hero {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 24px;
            align-items: center;
            margin-bottom: 28px;
        }

        .hero h1 {
            font-size: clamp(28px, 3.2vw, 44px);
            letter-spacing: -0.02em;
            margin: 0 0 12px;
        }

        .hero p {
            margin: 0;
            color: var(--muted);
            font-size: 16px;
        }

        .hero-panel {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 18px 20px;
            display: grid;
            gap: 12px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            border-radius: 999px;
            background: #ffe2d7;
            color: #4f2b24;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 16px;
        }

        .stat-card h3 {
            margin: 0 0 8px;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
        }

        .stat-card .value {
            font-size: 26px;
            font-weight: 700;
        }

        .layout {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 20px;
        }

        .card {
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 10px 30px rgba(40, 24, 10, 0.08);
        }

        .card h2 {
            margin: 0 0 14px;
            font-size: 18px;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 999px;
            background: #eef7f3;
            color: var(--accent-2);
            font-size: 12px;
            font-weight: 600;
        }

        .pipeline {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 10px;
        }

        .pipeline-item {
            background: #f9f5f1;
            border-radius: 12px;
            padding: 10px 12px;
            border: 1px solid var(--border);
        }

        .pipeline-item span {
            display: block;
            font-size: 12px;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .pipeline-item strong {
            font-size: 20px;
        }

        .tech-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tech-pill {
            padding: 6px 12px;
            border-radius: 999px;
            background: #fff1e2;
            border: 1px dashed #f0c7a5;
            font-size: 13px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        th, td {
            text-align: left;
            padding: 10px 8px;
            border-bottom: 1px solid #f0e4d6;
        }

        th {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
        }

        .empty {
            color: var(--muted);
            font-style: italic;
        }

        @media (max-width: 920px) {
            .hero {
                grid-template-columns: 1fr;
            }

            .stat-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .layout {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 640px) {
            .stat-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
<div class="page">
    <section class="hero">
        <div>
            <span class="badge">Job Hunter Engine</span>
            <h1>Dashboard de scraping et de priorisation</h1>
            <p>Vue instantanee sur le volume, la qualite et le suivi de tes candidatures.</p>
        </div>
        <div class="hero-panel">
            <div class="pill">Dernier run</div>
            {% if latestRun %}
                <div><strong>Status:</strong> {{ latestRun.status }}</div>
                <div><strong>Sources:</strong> {{ latestRun.sources|join(', ') }}</div>
                <div><strong>Queries:</strong> {{ latestRun.queries|join(', ') }}</div>
                <div><strong>Started:</strong> {{ latestRun.startedAt|date('Y-m-d H:i') }}</div>
            {% else %}
                <div class="empty">Aucun run enregistre.</div>
            {% endif %}
        </div>
    </section>

    <section class="stat-grid">
        <div class="stat-card">
            <h3>Total offres</h3>
            <div class="value">{{ totalJobs }}</div>
        </div>
        <div class="stat-card">
            <h3>Score moyen (20 derniers)</h3>
            <div class="value">{{ avgScore is not null ? avgScore ~ '/100' : 'n/a' }}</div>
        </div>
        <div class="stat-card">
            <h3>Technos dominantes</h3>
            <div class="value">{{ topTechs|length }}</div>
        </div>
        <div class="stat-card">
            <h3>Runs recents</h3>
            <div class="value">{{ recentRuns|length }}</div>
        </div>
    </section>

    <section class="layout">
        <div class="card">
            <h2>Pipeline candidatures</h2>
            {% if pipeline is empty %}
                <div class="empty">Aucun statut disponible.</div>
            {% else %}
                <div class="pipeline">
                    {% for row in pipeline %}
                        <div class="pipeline-item">
                            <span>{{ row.status }}</span>
                            <strong>{{ row.count }}</strong>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
            <div style="margin-top: 18px;">
                <h2>Technologies les plus vues</h2>
                {% if topTechs is empty %}
                    <div class="empty">Aucune techno extraite.</div>
                {% else %}
                    <div class="tech-list">
                        {% for name, count in topTechs %}
                            <span class="tech-pill">{{ name }} ({{ count }})</span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="card">
            <h2>Runs recents</h2>
            {% if recentRuns is empty %}
                <div class="empty">Aucun historique.</div>
            {% else %}
                <table>
                    <thead>
                    <tr>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Unique</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for run in recentRuns %}
                        <tr>
                            <td>{{ run.startedAt|date('m/d H:i') }}</td>
                            <td>{{ run.status }}</td>
                            <td>{{ run.uniqueListings }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </section>

    <section class="card" style="margin-top: 20px;">
        <h2>Dernieres offres</h2>
        {% if recentJobs is empty %}
            <div class="empty">Aucune offre en base.</div>
        {% else %}
            <table>
                <thead>
                <tr>
                    <th>Entreprise</th>
                    <th>Poste</th>
                    <th>Score</th>
                    <th>Statut</th>
                </tr>
                </thead>
                <tbody>
                {% for job in recentJobs %}
                    <tr>
                        <td>{{ job.company }}</td>
                        <td>{{ job.title }}</td>
                        <td>{{ job.relevanceScore is not null ? job.relevanceScore : 'n/a' }}</td>
                        <td>{{ job.status.value }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
</div>
</body>
</html>
