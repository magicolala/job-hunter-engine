{% extends 'base.html.twig' %}

{% block title %}Dashboard | Job Hunter Engine{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
{% endblock %}

{% block javascripts %}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
{% endblock %}

{% block body %}
<div class="animate-fade-in">
    <section class="hero">
        <h1>Dashboard de scraping</h1>
        <p>Vue instantanée sur le volume, la qualité et le suivi de tes candidatures.</p>
        {% for message in app.flashes('success') %}
            <div class="flash flash-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash flash-error">{{ message }}</div>
        {% endfor %}
        <div style="margin-top: 1.5rem; display: flex; gap: 1rem; justify-content: center;">
            <a class="btn btn-accent" href="/jobs">Voir les offres</a>
            <form method="post" action="/dashboard/run-scrape" style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center;" data-scrape-form>
                <div class="select-wrap">
                    <label for="sources" class="select-label">Sources</label>
                    <select id="sources" name="sources[]" class="select2" multiple>
                        <optgroup label="Disponibles">
                            <option value="wttj" selected>WTTJ</option>
                            <option value="wttj-api">WTTJ API</option>
                            <option value="remotive" selected>Remotive</option>
                        </optgroup>
                        <optgroup label="A venir">
                            <option value="linkedin" disabled>LinkedIn</option>
                            <option value="indeed" disabled>Indeed</option>
                            <option value="adzuna" disabled>Adzuna</option>
                            <option value="humancoders" disabled>HumanCoders</option>
                            <option value="alsacreations" disabled>Alsacreations</option>
                        </optgroup>
                    </select>
                    <div class="select-hint">Ctrl/Command pour multi-selection</div>
                </div>
                <input type="text" name="queries" value="symfony" placeholder="queries"
                       class="input">
                <input type="number" name="limit" placeholder="limite"
                       class="input" style="max-width: 90px;">
                <button type="submit" class="btn btn-primary" data-scrape-button>Lancer un scraping</button>
                <div class="scrape-loader" data-scrape-loader aria-live="polite">
                    <div class="spinner"></div>
                    <span>Scraping en cours…</span>
                </div>
            </form>
        </div>
    </section>

    <section class="stat-grid">
        <div class="card stat-card">
            <div class="stat-label">Total offres</div>
            <div class="stat-value">{{ totalJobs }}</div>
        </div>
        <div class="card stat-card">
            <div class="stat-label">Score moyen (20)</div>
            <div class="stat-value">{{ avgScore is not null ? avgScore|number_format(0) ~ '%' : 'n/a' }}</div>
        </div>
        <div class="card stat-card">
            <div class="stat-label">Technos dominantes</div>
            <div class="stat-value">{{ topTechs|length }}</div>
        </div>
        <div class="card stat-card">
            <div class="stat-label">Runs récents</div>
            <div class="stat-value">{{ recentRuns|length }}</div>
        </div>
    </section>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
        <div class="card">
            <h2 style="margin-bottom: 1.5rem;">Pipeline candidatures</h2>
            {% if pipeline is empty %}
                <p style="color: var(--text-muted); font-style: italic;">Aucun statut disponible.</p>
            {% else %}
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem;">
                    {% for row in pipeline %}
                        <div style="background: var(--bg-primary); padding: 1rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                            <div class="stat-label" style="font-size: 0.65rem;">{{ row.status }}</div>
                            <div style="font-size: 1.25rem; font-weight: 800;">{{ row.count }}</div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
            
            <h2 style="margin: 2rem 0 1.5rem;">Technologies populaires</h2>
            {% if topTechs is empty %}
                <p style="color: var(--text-muted); font-style: italic;">Aucune techno extraite.</p>
            {% else %}
                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                    {% for name, count in topTechs %}
                        <span class="badge badge-tech">{{ name }} <span style="opacity: 0.6; margin-left: 0.25rem;">{{ count }}</span></span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="card">
            <h2 style="margin-bottom: 1.5rem;">Dernier Run</h2>
            {% if latestRun %}
                <div style="display: grid; gap: 1rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                        <span class="stat-label">Status</span>
                        <span class="badge badge-status" style="background: var(--accent-success); color: white;">{{ latestRun.status }}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                        <span class="stat-label">Unique listings</span>
                        <span style="font-weight: 700;">{{ latestRun.uniqueListings }}</span>
                    </div>
                    <div>
                        <span class="stat-label" style="display: block; margin-bottom: 0.5rem;">Sources</span>
                        <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
                            {% for source in latestRun.sources %}
                                <span class="badge badge-status">{{ source }}</span>
                            {% endfor %}
                        </div>
                    </div>
                    <div>
                        <span class="stat-label" style="display: block; margin-bottom: 0.5rem;">Requêtes</span>
                        <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
                            {% for query in latestRun.queries %}
                                <span class="badge badge-status">{{ query }}</span>
                            {% endfor %}
                        </div>
                    </div>
                    <div style="padding-top: 0.5rem; text-align: right;">
                        <span style="font-size: 0.75rem; color: var(--text-muted);">Lancé le {{ latestRun.startedAt|date('d/m H:i') }}</span>
                    </div>
                </div>
            {% else %}
                <p style="color: var(--text-muted); font-style: italic;">Aucun run enregistré.</p>
            {% endif %}
        </div>
    </div>

    <section class="card">
        <h2 style="margin-bottom: 1.5rem;">Dernières offres</h2>
        {% if recentJobs is empty %}
            <p style="color: var(--text-muted); font-style: italic;">Aucune offre en base.</p>
        {% else %}
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Entreprise</th>
                            <th>Poste</th>
                            <th>Score</th>
                            <th>Statut</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for job in recentJobs %}
                            <tr>
                                <td style="font-weight: 700;">{{ job.company }}</td>
                                <td>{{ job.title }}</td>
                                <td>
                                    <span class="badge" style="background: {{ job.relevanceScore > 80 ? '#dcfce7' : (job.relevanceScore > 60 ? '#fef9c3' : '#f1f5f9') }}; 
                                                  color: {{ job.relevanceScore > 80 ? '#166534' : (job.relevanceScore > 60 ? '#854d0e' : '#475569') }}">
                                        {{ job.relevanceScore is not null ? job.relevanceScore ~ '%' : 'n/a' }}
                                    </span>
                                </td>
                                <td><span class="badge badge-status">{{ job.status.value }}</span></td>
                                <td style="text-align: right;">
                                    <a href="/jobs/{{ job.id }}" class="btn btn-primary" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">Voir</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</div>
<script>
    (() => {
        const form = document.querySelector('[data-scrape-form]');
        const button = document.querySelector('[data-scrape-button]');
        const loader = document.querySelector('[data-scrape-loader]');

        if (!form || !button || !loader) {
            return;
        }

        form.addEventListener('submit', () => {
            button.disabled = true;
            loader.style.display = 'inline-flex';
        });
    })();
</script>
<script>
    $(document).ready(() => {
        $('#sources').select2({
            width: 'resolve',
            placeholder: 'Sources',
            closeOnSelect: false
        });
    });
</script>
{% endblock %}
