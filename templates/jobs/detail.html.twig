<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Offre #{{ job.id }}</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

        :root {
            --bg: #f6f0e8;
            --ink: #1d1a16;
            --muted: #6b635c;
            --accent: #ff6b4a;
            --card: #ffffff;
            --border: #e3d7cb;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: 'Space Grotesk', sans-serif;
            color: var(--ink);
            background: var(--bg);
        }

        .page {
            max-width: 900px;
            margin: 0 auto;
            padding: 32px 24px 80px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px;
        }

        h1 { margin: 0 0 8px; }
        .meta { color: var(--muted); margin-bottom: 14px; }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
            margin-top: 16px;
        }

        .label {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--muted);
        }

        .value { font-weight: 600; }

        a { color: var(--accent); text-decoration: none; }

        .chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }

        .chip {
            padding: 6px 10px;
            border-radius: 999px;
            background: #fff1e2;
            border: 1px dashed #f0c7a5;
            font-size: 13px;
        }
    </style>
</head>
<body>
<div class="page">
    <div class="header">
        <a href="/jobs">Retour liste</a>
        <a href="/dashboard">Dashboard</a>
    </div>

    <div class="card">
        <h1>{{ job.title }}</h1>
        <div class="meta">{{ job.company }}</div>

        <div class="grid">
            <div>
                <div class="label">Statut</div>
                <div class="value">{{ job.status.value }}</div>
            </div>
            <div>
                <div class="label">Score</div>
                <div class="value">{{ job.relevanceScore is not null ? job.relevanceScore ~ '/100' : 'n/a' }}</div>
            </div>
            <div>
                <div class="label">Publication</div>
                <div class="value">{{ job.publishedAt ? job.publishedAt|date('Y-m-d') : 'n/a' }}</div>
            </div>
            <div>
                <div class="label">Ajoute</div>
                <div class="value">{{ job.createdAt|date('Y-m-d') }}</div>
            </div>
        </div>

        <div class="grid">
            <div>
                <div class="label">Source</div>
                <div class="value">{{ job.source }}</div>
            </div>
            <div>
                <div class="label">Localisation</div>
                <div class="value">{{ job.location ?: 'n/a' }}</div>
            </div>
            <div>
                <div class="label">Lien externe</div>
                <div class="value">
                    {% if job.jobUrl %}
                        <a href="{{ job.jobUrl }}" target="_blank" rel="noopener">Voir l'offre</a>
                    {% else %}
                        n/a
                    {% endif %}
                </div>
            </div>
        </div>

        <div style="margin-top: 16px;">
            <div class="label">Technologies</div>
            {% if job.technologies is empty %}
                <div class="value">n/a</div>
            {% else %}
                <div class="chips">
                    {% for tech in job.technologies %}
                        <span class="chip">{{ tech }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div style="margin-top: 18px;">
            <div class="label">Description</div>
            <div class="value">{{ job.description ?: 'n/a' }}</div>
        </div>
    </div>
</div>
</body>
</html>
