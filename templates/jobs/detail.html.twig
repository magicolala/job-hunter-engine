{% extends 'base.html.twig' %}

{% block title %}Offre #{{ job.id }} | Job Hunter Engine{% endblock %}

{% block body %}
<div class="animate-fade-in" style="max-width: 800px; margin: 0 auto;">
    <div style="margin-bottom: 2rem;">
        <a href="/jobs" class="btn" style="background: #f1f5f9; color: var(--text-muted); padding: 0.5rem 1rem;">
            ← Retour à la liste
        </a>
    </div>

    <article class="card" style="padding: 2rem;">
        <header style="margin-bottom: 2.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 2rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                <div>
                    <h1 style="margin-bottom: 0.5rem;">{{ job.title }}</h1>
                    <div style="font-size: 1.25rem; font-weight: 600; color: var(--accent-primary);">{{ job.company }}</div>
                </div>
                <div style="text-align: right;">
                    <div class="stat-label">Score de pertinence</div>
                    <div style="font-size: 2rem; font-weight: 800; color: {{ job.relevanceScore > 80 ? 'var(--accent-success)' : (job.relevanceScore > 60 ? '#ca8a04' : 'var(--text-muted)') }}">
                        {{ job.relevanceScore is not null ? job.relevanceScore ~ '%' : 'n/a' }}
                    </div>
                </div>
            </div>

            <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
                <span class="badge badge-status" style="font-size: 0.875rem; padding: 0.5rem 1rem;">{{ job.status.value }}</span>
                {% if job.location %}
                    <span class="badge badge-status" style="font-size: 0.875rem; padding: 0.5rem 1rem; background: #fff1f2; color: #be123c;">📍 {{ job.location }}</span>
                {% endif %}
                <span class="badge badge-status" style="font-size: 0.875rem; padding: 0.5rem 1rem; background: #f0fdf4; color: #15803d;">📅 {{ job.publishedAt ? job.publishedAt|date('d/m/Y') : 'Date inconnue' }}</span>
            </div>
        </header>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2.5rem;">
            <div>
                <h3 class="stat-label" style="margin-bottom: 0.75rem;">Source</h3>
                <div style="font-weight: 600;">{{ job.source }}</div>
            </div>
            <div>
                <h3 class="stat-label" style="margin-bottom: 0.75rem;">Lien direct</h3>
                {% if job.jobUrl %}
                    <a href="{{ job.jobUrl }}" target="_blank" rel="noopener" class="btn btn-accent" style="padding: 0.5rem 1rem; width: 100%;">
                        Voir l'offre originale ↗
                    </a>
                {% else %}
                    <div style="color: var(--text-muted); font-style: italic;">Non disponible</div>
                {% endif %}
            </div>
        </div>

        <div style="margin-bottom: 2.5rem;">
            <h3 class="stat-label" style="margin-bottom: 1rem;">Technologies identifiées</h3>
            {% if job.technologies is empty %}
                <div style="color: var(--text-muted); font-style: italic;">Aucune technologie détectée.</div>
            {% else %}
                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                    {% for tech in job.technologies %}
                        <span class="badge badge-tech" style="font-size: 0.875rem; padding: 0.4rem 0.8rem;">{{ tech }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div>
            <h3 class="stat-label" style="margin-bottom: 1rem;">Description du poste</h3>
            <div style="line-height: 1.7; color: #334155; background: #f8fafc; padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--border-color); white-space: pre-line;">
                {{ job.description ?: 'Aucune description disponible.' }}
            </div>
        </div>
    </article>

    <div style="margin-top: 2rem; text-align: center; color: var(--text-muted); font-size: 0.75rem;">
        Ajouté le {{ job.createdAt|date('d/m/Y à H:i') }}
    </div>
</div>
{% endblock %}
