{% extends 'base.html.twig' %}

{% block title %}Liste des offres | Job Hunter Engine{% endblock %}

{% block body %}
<div class="animate-fade-in">
    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem;">
        <h1>Liste des offres</h1>
        <p style="color: var(--text-muted); font-size: 0.875rem;">{{ jobs|length }} offres trouvées</p>
    </div>

    <section class="card" style="margin-bottom: 2rem; padding: 1.5rem;">
        <form method="get" action="" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.25rem; align-items: end;">
            <div>
                <label class="stat-label" style="display: block; margin-bottom: 0.5rem;">Technologies</label>
                <input type="text" name="technologies" value="{{ technologies|join(', ') }}" placeholder="ex: symfony, docker" 
                       style="width: 100%; padding: 0.625rem; border-radius: var(--radius-md); border: 1px solid var(--border-color); font-family: inherit;">
            </div>
            <div>
                <label class="stat-label" style="display: block; margin-bottom: 0.5rem;">Récence (jours)</label>
                <input type="number" name="days" value="{{ days }}" 
                       style="width: 100%; padding: 0.625rem; border-radius: var(--radius-md); border: 1px solid var(--border-color); font-family: inherit;">
            </div>
            <div>
                <label class="stat-label" style="display: block; margin-bottom: 0.5rem;">Statut</label>
                <select name="status" style="width: 100%; padding: 0.625rem; border-radius: var(--radius-md); border: 1px solid var(--border-color); font-family: inherit; background: white;">
                    <option value="">Tous les statuts</option>
                    <option value="FOUND" {{ status == 'FOUND' ? 'selected' : '' }}>FOUND</option>
                    <option value="APPLIED" {{ status == 'APPLIED' ? 'selected' : '' }}>APPLIED</option>
                    <option value="REJECTED" {{ status == 'REJECTED' ? 'selected' : '' }}>REJECTED</option>
                </select>
            </div>
            <div>
                <label class="stat-label" style="display: block; margin-bottom: 0.5rem;">Score min</label>
                <input type="number" name="minScore" value="{{ minScore }}" placeholder="70" 
                       style="width: 100%; padding: 0.625rem; border-radius: var(--radius-md); border: 1px solid var(--border-color); font-family: inherit;">
            </div>
            <div style="display: flex; gap: 0.5rem;">
                <button type="submit" class="btn btn-primary" style="flex: 1;">Filtrer</button>
                <a href="/jobs" class="btn" style="background: #f1f5f9; color: var(--text-muted);">Reset</a>
            </div>
        </form>
    </section>

    {% if jobs is empty %}
        <div class="card" style="text-align: center; padding: 4rem;">
            <p style="color: var(--text-muted); font-size: 1.125rem;">Aucune offre ne correspond aux filtres.</p>
            <a href="/jobs" class="btn btn-accent" style="margin-top: 1rem;">Réinitialiser les filtres</a>
        </div>
    {% else %}
        <div class="table-container shadow-sm">
            <table>
                <thead>
                    <tr>
                        <th>Entreprise</th>
                        <th>Poste</th>
                        <th>Publication</th>
                        <th>Score</th>
                        <th>Statut</th>
                        <th style="text-align: right;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for job in jobs %}
                        <tr>
                            <td style="font-weight: 700;">{{ job.company }}</td>
                            <td>{{ job.title }}</td>
                            <td style="color: var(--text-muted); font-size: 0.75rem;">{{ job.publishedAt ? job.publishedAt|date('d/m/Y') : job.createdAt|date('d/m/Y') }}</td>
                            <td>
                                <span class="badge" style="background: {{ job.relevanceScore > 80 ? '#dcfce7' : (job.relevanceScore > 60 ? '#fef9c3' : '#f1f5f9') }}; 
                                              color: {{ job.relevanceScore > 80 ? '#166534' : (job.relevanceScore > 60 ? '#854d0e' : '#475569') }}">
                                    {{ job.relevanceScore is not null ? job.relevanceScore ~ '%' : 'n/a' }}
                                </span>
                            </td>
                            <td><span class="badge badge-status">{{ job.status.value }}</span></td>
                            <td style="text-align: right; white-space: nowrap;">
                                <a href="/jobs/{{ job.id }}" class="btn btn-primary" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">Détail</a>
                                {% if job.jobUrl %}
                                    <a href="{{ job.jobUrl }}" target="_blank" rel="noopener" class="btn" style="padding: 0.4rem 0.8rem; font-size: 0.75rem; background: #f1f5f9; color: var(--text-muted); margin-left: 0.25rem;">Lien</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
